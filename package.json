{
	"name": "@wq2/miniblox-sdk",
	"version": "3.46.200-0.0.0",
	"license": "AGPL-3.0-only",
	"description": "SDK for Miniblox (mostly typings), originally from Vape Rewrite & Spherical.",
	"readme": "ReadME.md",
	"repository": {
		"url": "git+https://github.com/MinibloxCheaters2/miniblox-types.git"
	},
	"packageManager": "bun@1.3.14",
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown -w",
		"lint": "oxlint src",
		"lint:fix": "oxlint src --fix",
		"fmt": "oxfmt src",
		"prepublishOnly": "bun run build"
	},
	"files": [
		"dist",
		"LICENSE.md",
		"ReadME.md"
	],
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": "./dist/index.mjs"
	},
	"types": "./dist/index.d.mts",
	"type": "module",
	"dependencies": {
		"@types/three": "^0.184.1"
	},
	"devDependencies": {
		"oxfmt": "^0.62.0",
		"oxlint": "^1.77.0",
		"tsdown": "^0.22.12",
		"typescript": "^7.0.2"
	}
}
