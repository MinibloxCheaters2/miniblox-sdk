{
	"name": "@wq2/miniblox-sdk",
	"version": "3.46.147-0.0.0",
	"description": "SDK for Miniblox (mostly typings), originally from Vape Rewrite & Spherical.",
	"readme": "ReadME.md",
	"repository": {
		"url": "git+https://github.com/MinibloxCheaters2/miniblox-types.git"
	},
	"packageManager": "bun@1.3.14",
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown -w",
		"prepublishOnly": "bun run build"
	},
	"files": [
		"dist",
		"ReadME.md"
	],
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": "./dist/index.mjs"
	},
	"types": "./dist/index.d.mts",
	"type": "module",
	"dependencies": {
		"@types/three": "0.184.0"
	},
	"devDependencies": {
		"tsdown": "^0.22.12",
		"typescript": "^6.0.3"
	}
}
